# Copy to .env next to docker-compose.yml. Everything is optional except
# DAILY_SEED_SECRET once the dungeon is reachable.

# Pin a known-good image (TAG=v1.0.0) to roll back.
TAG=latest

# Methuselah snapshot endpoint (see docs/STATE.md). Empty values keep the
# service local-only: state stays in the named volume, no network layer.
STATE_ENDPOINT=http://methuselah.lan:8090
STATE_TOKEN=change-me
BACKUP_INTERVAL_SEC=3600

# World tick cadence: one day budget per tick in v1.
TICK_INTERVAL_SEC=86400

# Dungeon secrets. Generate once, e.g.:
#   openssl rand -hex 32
DAILY_SEED_SECRET=
DAILY_EPOCH=2026-11-02

# Public hosts routed by Traefik.
MORTAR_HOST=mortar.twinloopgames.com
SUNDER_HOST=sunder.twinloopgames.com
